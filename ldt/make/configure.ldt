FC              = mpiifx
FC77            = mpiifx
LD              = mpiifx
CC              = mpiicx
AR              = ar
MOD_ESMF        = /apps/leuven/rocky8/skylake/2023b/software/ESMF/8.6.1-intel-2023b/mod
LIB_ESMF        = /apps/leuven/rocky8/skylake/2023b/software/ESMF/8.6.1-intel-2023b/lib
INC_JPEG2000      = /apps/leuven/rocky8/skylake/2023b/software/JasPer/4.0.0-GCCcore-13.2.0/include/
LIB_JPEG2000      = /apps/leuven/rocky8/skylake/2023b/software/JasPer/4.0.0-GCCcore-13.2.0/lib64/
INC_ECCODES     = /apps/leuven/rocky8/skylake/2023b/software/ecCodes/2.31.0-iimpi-2023b/include/
LIB_ECCODES     = /apps/leuven/rocky8/skylake/2023b/software/ecCodes/2.31.0-iimpi-2023b/lib/
INC_NETCDF      = /apps/leuven/rocky8/skylake/2023b/software/netCDF/4.9.2-iimpi-2023b/include/
LIB_NETCDF      = /apps/leuven/rocky8/skylake/2023b/software/netCDF/4.9.2-iimpi-2023b/lib/
INC_HDF4        = 
LIB_HDF4        = 
INC_HDF5        = /apps/leuven/rocky8/skylake/2023b/software/HDF5/1.14.3-iimpi-2023b/include/
LIB_HDF5        = /apps/leuven/rocky8/skylake/2023b/software/HDF5/1.14.3-iimpi-2023b/lib/
INC_HDFEOS      = 
LIB_HDFEOS      = 
INC_FORTRANGIS1 = 
INC_FORTRANGIS2 = 
LIB_FORTRANGIS  = 
INC_LIBGEOTIFF  = 
LIB_LIBGEOTIFF  = 
LIB_GDAL        = 
CFLAGS          = -c -O2 -DIFC
FFLAGS77        = -c -O2 -nomixed_str_len_arg -names lowercase -convert big_endian -assume byterecl  -DIFC -I$(MOD_ESMF) -DUSE_INCLUDE_MPI -I$(INC_ECCODES) -I$(INC_NETCDF)  -I$(INC_HDF5) 
FFLAGS          =  -c -O2 -u -traceback -fpe0  -nomixed-str-len-arg -names lowercase -convert big_endian -assume byterecl -DIFC -I$(MOD_ESMF) -DUSE_INCLUDE_MPI -I$(INC_ECCODES) -I$(INC_NETCDF)  -I$(INC_HDF5) 
LDFLAGS         =  -L$(LIB_ESMF) -Wl,-rpath=$(LIB_ESMF) -lesmf -lstdc++ -limf -lm -lrt -lz -L$(LIB_ECCODES) -Wl,-rpath=$(LIB_ECCODES) -leccodes_f90 -leccodes -L$(LIB_JPEG2000) -Wl,-rpath=$(LIB_JPEG2000) -ljasper -L$(LIB_NETCDF) -Wl,-rpath=$(LIB_NETCDF) -lnetcdff -lnetcdf -L$(LIB_HDF5) -Wl,-rpath=$(LIB_HDF5) -lhdf5_fortran -lhdf5_hl -lhdf5 -ldl -ltirpc -lmkl -lsz -lpioc
